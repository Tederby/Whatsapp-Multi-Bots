# ==============================================================================
# 🤖 BOT BASIC CONFIGURATION
# ==============================================================================
# Display name of the bot shown in menus and info
BOT_NAME=Tederby18

# Bot Owner WhatsApp Number (Format: Country code + phone number without '+')
# For multiple owners, separate with commas: 628123456789,628987654321
OWNER_NUMBER=6287825136146

# Enabled command prefixes (each character is a valid prefix)
PREFIXES=!.#/-

# Spam filter cooldown per user/chat in milliseconds (e.g. 3000 = 3 seconds)
SPAM_DELAY=3000

# ==============================================================================
# 🔑 THIRD-PARTY API KEYS (OPTIONAL)
# Safe to leave blank; related commands will simply display an informative note.
# ==============================================================================

# Google Gemini API Key for AI translation (!translate)
# Get free at: https://aistudio.google.com/
GEMINI_API_KEY=

# YouTube Data API v3 Key for YouTube video search (!yts)
# Get free at: https://console.cloud.google.com/ (Enable YouTube Data API v3)
YOUTUBE_API_KEY=

# Steam Web API Key for Steam profile lookup (!steamprofile)
# Get at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# ==============================================================================
# 🎨 BRANDING & CUSTOMIZATION (OPTIONAL)
# ==============================================================================
# Photo URL sent when users trigger the !owner command
OWNER_IMAGE=https://cdn.donmai.us/sample/3a/78/__hatsune_miku_mii_and_mikudayo_vocaloid_and_2_more_drawn_by_yunkkker__sample-3a782c2a60fa7c871f6edad47fd88dc1.jpg

# WhatsApp Channel / Official community link displayed in !info
CHANNEL_URL=https://whatsapp.com/channel/0029VbB1Xqv1noz03aqgWx0s

# Default sticker pack name and author for sticker makers (!brat, !sticker, etc.)
STICKER_PACK=WhatsApp Bot
STICKER_AUTHOR=Tederby

# ==============================================================================
# 💻 REMOTE TERMINAL CONFIGURATION (OPTIONAL - SYSTEM OWNER ONLY)
# SSH configuration to run remote server shell commands via !bash
# ==============================================================================
SSH_HOST=103.168.146.150
SSH_PORT=40015
SSH_USER=root
